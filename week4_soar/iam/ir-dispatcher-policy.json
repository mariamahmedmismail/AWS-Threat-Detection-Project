{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadForScopeIdempotencyAndEvidence",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "iam:ListUserTags",
        "iam:GetInstanceProfile",
        "s3:GetBucketTagging",
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketPublicAccessBlock",
        "iam:ListRoleTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SnapshotEvidence",
      "Effect": "Allow",
      "Action": "ec2:CreateSnapshots",
      "Resource": [
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:REGION:ACCOUNT_ID:volume/*",
        "arn:aws:ec2:REGION::snapshot/*"
      ]
    },
    {
      "Sid": "TagSnapshotsAtCreation",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:REGION::snapshot/*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "CreateSnapshots"
        }
      }
    },
    {
      "Sid": "IsolateAndTagSandboxInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": "sandbox"
        }
      }
    },
    {
      "Sid": "IsolateInterfacesOfMultiEniInstances",
      "Effect": "Allow",
      "Action": "ec2:ModifyNetworkInterfaceAttribute",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:network-interface/*"
    },
    {
      "Sid": "UseIsolationSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyNetworkInterfaceAttribute"
      ],
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:security-group/ISOLATION_SG_ID"
    },
    {
      "Sid": "ContainSandboxIamUsers",
      "Effect": "Allow",
      "Action": [
        "iam:UpdateAccessKey",
        "iam:TagUser",
        "iam:PutUserPolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:user/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": "sandbox"
        }
      }
    },
    {
      "Sid": "RevokeSessionsOnSandboxRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:TagRole"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/env": "sandbox"
        }
      }
    },
    {
      "Sid": "ContainBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging"
      ],
      "Resource": "arn:aws:s3:::*"
    },
    {
      "Sid": "WriteRecordsAndEvidence",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::EVIDENCE_BUCKET/actions/*",
        "arn:aws:s3:::EVIDENCE_BUCKET/evidence/*"
      ]
    },
    {
      "Sid": "ListRecordsForIdempotency",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::EVIDENCE_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": "actions/*"
        }
      }
    },
    {
      "Sid": "Report",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:REGION:ACCOUNT_ID:ir-alerts"
    },
    {
      "Sid": "UpdateSecurityHubFindings",
      "Effect": "Allow",
      "Action": "securityhub:BatchUpdateFindings",
      "Resource": "*"
    },
    {
      "Sid": "StartForensicsRunbook",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:automation-definition/IR-CollectEC2Forensics:*"
    },
    {
      "Sid": "PassAutomationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ir-forensics-automation-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ssm.amazonaws.com"
        }
      }
    },
    {
      "Sid": "FailureDestination",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:REGION:ACCOUNT_ID:ir-lambda-dlq"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:REGION:ACCOUNT_ID:log-group:/aws/lambda/ir-dispatcher:*"
    },
    {
      "Sid": "NeverDestroyOrTouchEvidence",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteSnapshot",
        "ec2:DeleteVolume",
        "iam:DeleteAccessKey",
        "iam:DeleteUser",
        "s3:DeleteBucket",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DoNotContainOwnBuckets",
      "Effect": "Deny",
      "Action": [
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging"
      ],
      "Resource": [
        "arn:aws:s3:::EVIDENCE_BUCKET",
        "arn:aws:s3:::LOG_BUCKET"
      ]
    }
  ]
}
